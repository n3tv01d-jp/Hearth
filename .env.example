# Copy to .env (never commit .env).

# Shared secret between the hub and its agents. Generate one with:
#   openssl rand -hex 24
HEARTH_TOKEN=

# Agents only: LAN address of the machine running the hub.
HEARTH_HUB=http://192.168.1.10:8088

# Optional
TZ=UTC

# Push alerts (hub): comma-separated ntfy / Gotify / Discord / Slack / webhook URLs.
#   HEARTH_NOTIFY=https://ntfy.sh/my-secret-topic
HEARTH_NOTIFY=

# Beacons (hub): ping / TCP / HTTP checks for devices that can't run an agent.
#   HEARTH_CHECKS=router=192.168.1.1, printer=tcp:192.168.1.50:631, ha=http://192.168.1.20:8123
HEARTH_CHECKS=

# Container control: 1 lets the dashboard start / stop / restart containers and read their logs.
# Needed on the hub AND on each agent whose containers you want to control. The dashboard has
# no login, so anyone who can reach it can use these buttons.
HEARTH_ALLOW_CONTROL=0

# Self-update: ARSENAL's UPDATE HEARTH pulls the newest published image and restarts HEARTH on it
# (it can only touch HEARTH's own container). 0 turns the button off on this machine.
HEARTH_SELF_UPDATE=1
# The image HEARTH runs and updates from. Pin a version (…/hearth:3.4) to only get its fixes.
# HEARTH_IMAGE=ghcr.io/n3tv01d-jp/hearth:latest

# ── GATE 転送門 (hub) ──
# Bookmarks for things that aren't containers (you can also add them from the page).
#   HEARTH_GATE_LINKS=Router=http://192.168.1.1, ISP status=https://status.example.com
HEARTH_GATE_LINKS=
# Host names to use in links instead of IP addresses (node=host).
#   HEARTH_GATE_HOSTS=nas=nas.lan, pi=pi.lan
HEARTH_GATE_HOSTS=
# Wake-on-LAN for machines that don't run an agent (agents' MACs are learned automatically).
#   HEARTH_WOL=desktop=aa:bb:cc:dd:ee:ff, htpc=11:22:33:44:55:66@192.168.1.255
HEARTH_WOL=

# ── ARSENAL 工廠 ──
# Backups to watch on THIS machine (hub or agent): name=/path[@max-age]. restic and borg repos are
# recognised; for anything else the newest file counts. Default max age 26h.
#   HEARTH_BACKUPS=photos=/mnt/backup/restic@26h, dumps=/srv/dumps/*.sql.gz@2d
HEARTH_BACKUPS=
# Hub only: jobs that report in over HTTP (curl http://hub:8088/api/ping/offsite, or …/fail).
#   HEARTH_HEARTBEATS=offsite=26h, b2-sync=8d
HEARTH_HEARTBEATS=
